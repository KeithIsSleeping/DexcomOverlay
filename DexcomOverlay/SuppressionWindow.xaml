<Window x:Class="DexcomOverlay.SuppressionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alert Suppression"
        Icon="pack://application:,,,/app.ico"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#2D2D2D"
        Topmost="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4,0,2" />
        </Style>
        <Style TargetType="Button" x:Key="LinkBtn">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#55AAFF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style TargetType="Button" x:Key="TimerBtn">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#444444" />
            <Setter Property="BorderBrush" Value="#666666" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
        <StackPanel Margin="16">
            <!-- Header -->
            <TextBlock Text="Alert Suppression"
                       FontSize="16" FontWeight="Bold"
                       Foreground="White" Margin="0,0,0,8" />

            <!-- ── Global Suppression ──────────────────── -->
            <Border Background="#333333" CornerRadius="6" Padding="10" Margin="0,4">
                <StackPanel>
                    <TextBlock Text="Global Suppression (all alerts)"
                               FontWeight="SemiBold" Foreground="White" FontSize="13" />
                    <TextBlock x:Name="GlobalStatusLabel"
                               Text="No active suppression"
                               Foreground="#888888" FontSize="11" Margin="0,2,0,6" />

                    <TextBlock Text="Quick suppress:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2" />
                    <WrapPanel>
                        <Button Content="10 min" Style="{StaticResource TimerBtn}" Click="GlobalSuppress10_Click" />
                        <Button Content="30 min" Style="{StaticResource TimerBtn}" Click="GlobalSuppress30_Click" />
                        <Button Content="1 hour" Style="{StaticResource TimerBtn}" Click="GlobalSuppress60_Click" />
                        <Button Content="2 hours" Style="{StaticResource TimerBtn}" Click="GlobalSuppress120_Click" />
                        <Button Content="Indefinite" Style="{StaticResource TimerBtn}" Click="GlobalSuppressIndefinite_Click" />
                        <Button Content="✕ Clear" Style="{StaticResource TimerBtn}" Foreground="#FF6666" Click="GlobalClear_Click" />
                    </WrapPanel>

                    <!-- Schedule -->
                    <CheckBox x:Name="GlobalScheduleEnabled" Content="Enable schedule" Margin="0,10,0,2"
                              Checked="GlobalSchedule_Changed" Unchecked="GlobalSchedule_Changed" />
                    <StackPanel x:Name="GlobalSchedulePanel" Visibility="Collapsed" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="From" VerticalAlignment="Center" />
                            <TextBox x:Name="GlobalScheduleStart" Width="60" Margin="6,0" Text="22:00" />
                            <TextBlock Text="to" VerticalAlignment="Center" />
                            <TextBox x:Name="GlobalScheduleEnd" Width="60" Margin="6,0" Text="07:00" />
                        </StackPanel>
                        <TextBlock Text="Days (leave unchecked = every day):" FontSize="10" Foreground="#999999" Margin="0,4,0,2" />
                        <WrapPanel>
                            <CheckBox x:Name="GDay0" Content="Sun" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="GDay1" Content="Mon" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="GDay2" Content="Tue" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="GDay3" Content="Wed" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="GDay4" Content="Thu" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="GDay5" Content="Fri" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="GDay6" Content="Sat" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Per-Type Suppression ────────────────── -->
            <TextBlock Text="Per Alert Type" FontWeight="SemiBold" FontSize="13"
                       Foreground="White" Margin="0,12,0,4" />

            <TextBlock Text="Select an alert type to configure:"
                       FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4" />

            <ComboBox x:Name="AlertTypeCombo" SelectionChanged="AlertTypeCombo_SelectionChanged">
                <ComboBoxItem Content="Urgent Low" Tag="UrgentLow" />
                <ComboBoxItem Content="Low" Tag="Low" />
                <ComboBoxItem Content="Predicted Low" Tag="PredictedLow" />
                <ComboBoxItem Content="High" Tag="High" />
                <ComboBoxItem Content="Predicted High" Tag="PredictedHigh" />
                <ComboBoxItem Content="Urgent High" Tag="UrgentHigh" />
                <ComboBoxItem Content="No Data" Tag="NoData" />
            </ComboBox>

            <Border x:Name="PerTypePanel" Background="#333333" CornerRadius="6"
                    Padding="10" Margin="0,6" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="PerTypeStatusLabel"
                               Text="No active suppression"
                               Foreground="#888888" FontSize="11" Margin="0,0,0,6" />

                    <TextBlock Text="Quick suppress:" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2" />
                    <WrapPanel>
                        <Button Content="10 min" Style="{StaticResource TimerBtn}" Click="TypeSuppress10_Click" />
                        <Button Content="30 min" Style="{StaticResource TimerBtn}" Click="TypeSuppress30_Click" />
                        <Button Content="1 hour" Style="{StaticResource TimerBtn}" Click="TypeSuppress60_Click" />
                        <Button Content="2 hours" Style="{StaticResource TimerBtn}" Click="TypeSuppress120_Click" />
                        <Button Content="Indefinite" Style="{StaticResource TimerBtn}" Click="TypeSuppressIndefinite_Click" />
                        <Button Content="✕ Clear" Style="{StaticResource TimerBtn}" Foreground="#FF6666" Click="TypeClear_Click" />
                    </WrapPanel>

                    <!-- Per-type schedule -->
                    <CheckBox x:Name="TypeScheduleEnabled" Content="Enable schedule" Margin="0,10,0,2"
                              Checked="TypeSchedule_Changed" Unchecked="TypeSchedule_Changed" />
                    <StackPanel x:Name="TypeSchedulePanel" Visibility="Collapsed" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="From" VerticalAlignment="Center" />
                            <TextBox x:Name="TypeScheduleStart" Width="60" Margin="6,0" Text="22:00" />
                            <TextBlock Text="to" VerticalAlignment="Center" />
                            <TextBox x:Name="TypeScheduleEnd" Width="60" Margin="6,0" Text="07:00" />
                        </StackPanel>
                        <TextBlock Text="Days (leave unchecked = every day):" FontSize="10" Foreground="#999999" Margin="0,4,0,2" />
                        <WrapPanel>
                            <CheckBox x:Name="TDay0" Content="Sun" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="TDay1" Content="Mon" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="TDay2" Content="Tue" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="TDay3" Content="Wed" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="TDay4" Content="Thu" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="TDay5" Content="Fri" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                            <CheckBox x:Name="TDay6" Content="Sat" Margin="0,0,8,0" Foreground="#CCCCCC" FontSize="11" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Active Suppressions Summary ─────────── -->
            <Border Background="#2A2A3A" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="Active Suppressions" FontWeight="SemiBold" Foreground="#AAAACC" FontSize="12" />
                    <TextBlock x:Name="SummaryLabel"
                               Text="None"
                               Foreground="#888888" FontSize="11"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button Content="Clear All Suppressions"
                        Click="ClearAll_Click"
                        FontFamily="Segoe UI" FontSize="12"
                        Background="#CC3333" Foreground="White"
                        Padding="14,6" Margin="4,0"
                        Cursor="Hand" />
                <Button Content="Close"
                        Click="Close_Click"
                        FontFamily="Segoe UI" FontSize="12"
                        Background="#555555" Foreground="White"
                        Padding="14,6" Margin="4,0"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
