<Window x:Class="DexcomOverlay.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dexcom Glucose Graph"
        Icon="pack://application:,,,/app.ico"
        Width="900" Height="520"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Topmost="True"
        ResizeMode="CanResize"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <Style x:Key="TimeBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="ActiveTimeBtn" TargetType="Button" BasedOn="{StaticResource TimeBtn}">
            <Setter Property="Background" Value="#0078D4" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0078D4" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: current reading + back button -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock x:Name="CurrentValueLabel"
                           Text="---"
                           FontFamily="Segoe UI" FontWeight="Bold" FontSize="28"
                           Foreground="White" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock x:Name="CurrentTrendLabel"
                           Text=""
                           FontFamily="Segoe UI" FontSize="20"
                           Foreground="White" VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBlock x:Name="CurrentInfoLabel"
                           Text=""
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="#888888" VerticalAlignment="Center" />
            </StackPanel>

            <Button Content="✕ Close"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Click="Close_Click"
                    FontFamily="Segoe UI" FontSize="12"
                    Foreground="#CCCCCC" Background="#333333"
                    BorderBrush="#555555" BorderThickness="1"
                    Padding="10,4" Cursor="Hand" />
        </Grid>

        <!-- Graph canvas area -->
        <Border Grid.Row="1" Background="#111111" CornerRadius="4" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Canvas x:Name="GraphCanvas" />
                <!-- Loading overlay -->
                <TextBlock x:Name="LoadingLabel"
                           Text="Loading data..."
                           FontFamily="Segoe UI" FontSize="16"
                           Foreground="#888888"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Timeline buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
            <Button x:Name="Btn1h"  Content="1h"  Click="TimeWindow_Click" Tag="60"   Style="{StaticResource TimeBtn}" />
            <Button x:Name="Btn3h"  Content="3h"  Click="TimeWindow_Click" Tag="180"  Style="{StaticResource TimeBtn}" />
            <Button x:Name="Btn6h"  Content="6h"  Click="TimeWindow_Click" Tag="360"  Style="{StaticResource TimeBtn}" />
            <Button x:Name="Btn12h" Content="12h" Click="TimeWindow_Click" Tag="720"  Style="{StaticResource TimeBtn}" />
            <Button x:Name="Btn24h" Content="24h" Click="TimeWindow_Click" Tag="1440" Style="{StaticResource TimeBtn}" />
        </StackPanel>

        <!-- Legend -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
            <Ellipse Width="8" Height="8" Fill="#FF0000" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="Urgent Low/High" Foreground="#888888" FontSize="10" FontFamily="Segoe UI" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Ellipse Width="8" Height="8" Fill="#FF8800" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="Low" Foreground="#888888" FontSize="10" FontFamily="Segoe UI" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Ellipse Width="8" Height="8" Fill="#00CC66" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="In Range" Foreground="#888888" FontSize="10" FontFamily="Segoe UI" Margin="0,0,12,0" VerticalAlignment="Center" />
            <Ellipse Width="8" Height="8" Fill="#FFCC00" Margin="0,0,4,0" VerticalAlignment="Center" />
            <TextBlock Text="High" Foreground="#888888" FontSize="10" FontFamily="Segoe UI" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Text="▲ = Alert triggered" Foreground="#FF4444" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
