<Window x:Class="DexcomOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dexcom Overlay Settings"
        Icon="pack://application:,,,/app.ico"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#2D2D2D"
        Topmost="True">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <!-- Credentials -->
        <TextBlock Text="Username / Email / Phone" />
        <TextBox x:Name="UsernameBox" />

        <TextBlock Text="Password" />
        <PasswordBox x:Name="PasswordBox" />

        <TextBlock Text="Region" />
        <ComboBox x:Name="RegionCombo" SelectedIndex="0">
            <ComboBoxItem Content="US" Tag="us" />
            <ComboBoxItem Content="Outside US" Tag="ous" />
            <ComboBoxItem Content="Japan" Tag="jp" />
        </ComboBox>

        <!-- Display settings -->
        <TextBlock Text="Refresh interval (seconds)" Margin="0,14,0,2" />
        <TextBox x:Name="RefreshBox" />

        <TextBlock Text="Font size" />
        <TextBox x:Name="FontSizeBox" />

        <TextBlock Text="Opacity (0.1 - 1.0)" />
        <TextBox x:Name="OpacityBox" />

        <!-- Thresholds -->
        <TextBlock Text="──── Glucose Thresholds (mg/dL) ────"
                   Foreground="#888888" FontSize="11" Margin="0,14,0,6"
                   HorizontalAlignment="Center" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="Urg Low" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Foreground="#AAAAAA" FontSize="10" />
            <TextBlock Text="Low"     Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Foreground="#AAAAAA" FontSize="10" />
            <TextBlock Text="High"    Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Foreground="#AAAAAA" FontSize="10" />
            <TextBlock Text="Urg High" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center" Foreground="#AAAAAA" FontSize="10" />

            <TextBox x:Name="UrgLowBox"  Grid.Row="1" Grid.Column="0" Margin="2" Width="60" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBox x:Name="LowBox"     Grid.Row="1" Grid.Column="1" Margin="2" Width="60" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBox x:Name="HighBox"    Grid.Row="1" Grid.Column="2" Margin="2" Width="60" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBox x:Name="UrgHighBox" Grid.Row="1" Grid.Column="3" Margin="2" Width="60" HorizontalAlignment="Center" TextAlignment="Center" />
        </Grid>

        <!-- Alerts -->
        <CheckBox x:Name="AlertsCheckBox"
                  Content="Enable predictive low/high alerts"
                  Foreground="#CCCCCC"
                  FontFamily="Segoe UI" FontSize="12"
                  Margin="0,14,0,0"
                  IsChecked="True" />

        <!-- Save button -->
        <Button Content="Save &amp; Reconnect"
                Click="Save_Click"
                FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                Background="#0078D4" Foreground="White"
                Padding="16,6" Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Cursor="Hand" />
    </StackPanel>
</Window>
