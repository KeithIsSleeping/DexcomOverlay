<Window x:Class="DexcomOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dexcom Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Settings..." Click="Settings_Click" />
            <MenuItem Header="Refresh Now" Click="Refresh_Click" />
            <MenuItem Header="Graph" Click="Graph_Click" />
            <Separator />
            <MenuItem Header="Toggle mmol/L" Click="ToggleUnits_Click" />
            <MenuItem Header="Minimize" Click="Minimize_Click" />
            <Separator />
            <MenuItem Header="Exit" Click="Exit_Click" />
        </ContextMenu>
    </Window.ContextMenu>

    <Border Background="#F01E1E1E" CornerRadius="8" Padding="12,6" BorderBrush="#80FFFFFF" BorderThickness="1" MinWidth="180" MinHeight="70">
        <Grid>
            <!-- Close button in top-right corner -->
            <TextBlock Text="✕" 
                       Foreground="#66FFFFFF" 
                       FontSize="10" 
                       HorizontalAlignment="Right" 
                       VerticalAlignment="Top" 
                       Margin="0,-2,-4,0"
                       Cursor="Hand"
                       MouseLeftButtonDown="Close_Click" />

            <!-- Minimize button next to close -->
            <TextBlock Text="─"
                       Foreground="#66FFFFFF"
                       FontSize="10"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,-2,10,0"
                       Cursor="Hand"
                       PreviewMouseLeftButtonDown="Minimize_MouseDown" />
            <!-- Graph button -->
            <TextBlock Text="▤"
                       Foreground="#66FFFFFF"
                       FontSize="11"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,-2,22,0"
                       Cursor="Hand"
                       ToolTip="Open graph view"
                       PreviewMouseLeftButtonDown="Graph_MouseDown" />
            <!-- Status dot in top-left corner -->
            <Ellipse x:Name="StatusDot"
                     Width="6" Height="6"
                     Fill="#555555"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     Margin="0,2,0,0" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Glucose Value -->
                <TextBlock x:Name="GlucoseLabel"
                           Text="---"
                           FontFamily="Segoe UI"
                           FontWeight="Bold"
                           FontSize="48"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />

                <!-- Trend + Unit stack -->
                <StackPanel VerticalAlignment="Center" Margin="0,4,0,0">
                    <TextBlock x:Name="TrendLabel"
                               Text=""
                               FontFamily="Segoe UI"
                               FontSize="24"
                               Foreground="White" />
                    <TextBlock x:Name="InfoLabel"
                               Text="mg/dL"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               Foreground="#888888" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
